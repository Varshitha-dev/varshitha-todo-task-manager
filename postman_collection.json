{
  "info": {
    "name": "To-Do Task Manager API",
    "_postman_id": "todo-task-manager-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "taskId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Test task\",\"description\":\"Created from Postman\",\"deadline\":\"2026-10-31\",\"priority\":\"High\",\"status\":\"Pending\"}"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks?status=All"
      }
    },
    {
      "name": "Search tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks?search=Test&priority=High"
      }
    },
    {
      "name": "Get task by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    },
    {
      "name": "Patch task status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"Completed\"}"
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    },
    {
      "name": "Replace task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Updated test task\",\"description\":\"Updated from Postman\",\"deadline\":\"2026-11-05\",\"priority\":\"Medium\",\"status\":\"Pending\"}"
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    },
    {
      "name": "Delete task",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    },
    {
      "name": "Validation - empty title (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"   \"}"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    }
  ]
}